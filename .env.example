# Скопируй файл в .env и впиши свои значения
DEBUG=True
SECRET_KEY=[СЛУЧАЙНАЯ_ДЛИННАЯ_СТРОКА]
# Локально можно не задавать — будет db.sqlite3. На Render сюда вставляется строка PostgreSQL
# DATABASE_URL=postgresql://user:password@host/dbname
# Уведомления о заявках в Telegram (необязательно)
TELEGRAM_BOT_TOKEN=[ТОКЕН_БОТА]
TELEGRAM_CHAT_ID=[ТВОЙ_CHAT_ID]
